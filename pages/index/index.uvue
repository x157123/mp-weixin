	}

	.empty-hint {
		font-size: 24rpx;
		color: #BBB;
	}

	.record-list {
		padding: 0 24rpx;
		flex-direction: column;
	}

	.record-card {
		background-color: #FFFFFF;
		border-radius: 24rpx;
		padding: 24rpx 24rpx 24rpx 20rpx;
		margin-bottom: 16rpx;
		flex-direction: row;
		align-items: center;
	}

	.record-time-col {
		width: 110rpx;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.record-time {
		font-size: 30rpx;
		font-weight: bold;
		color: #FF6B7A;
	}

	.time-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: 6rpx;
		background-color: #FF6B7A;
		margin-top: 10rpx;
	}

	.record-interval {
		font-size: 20rpx;
		color: #B0B0B8;
		margin-top: 8rpx;
	}

	.record-main {
		flex: 1;
