		align-items: center;
	}

	.record-time-col {
		width: 110rpx;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.record-time {
		font-size: 30rpx;
		font-weight: bold;
		color: #FF6B7A;
	}

	.time-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: 6rpx;
		background-color: #FF6B7A;
		margin-top: 10rpx;
	}

	.record-interval {
		font-size: 20rpx;
		color: #B0B0B8;
		margin-top: 8rpx;
	}

	.record-main {
		flex: 1;
		flex-direction: column;
		padding: 0 16rpx;
	}

	.record-row1 {
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	.record-milk {
		font-size: 30rpx;
		color: #3A3A3A;
		font-weight: bold;
		margin-right: 18rpx;
	}

	.record-day {
		font-size: 22rpx;
		color: #909399;
