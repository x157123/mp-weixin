<template>
	<view class="page">
			<view class="hero">
				<view class="hero-inner">
					<text class="hero-title">历史记录</text>
					<text class="hero-sub">共 {{ records.length }} 条记录</text>
				</view>
			</view>

		<scroll-view class="scroll-area" scroll-y="true">
			<view class="content">
				<view class="empty" v-if="records.length === 0">
					<text class="empty-icon">📭</text>
					<text class="empty-text">还没有任何记录</text>
					<text class="empty-hint">点击底部 ＋ 开始记录</text>
				</view>

				<view class="day-group" v-for="grp in grouped" :key="grp.dateKey">
					<view class="day-header" @click="toggleDay(grp.dateKey)">
						<view class="day-header-left">
							<text class="day-chevron">{{ isExpanded(grp.dateKey) ? '▾' : '▸' }}</text>
							<text class="day-label">{{ grp.title }}</text>
						</view>
						<text class="day-summary">{{ grp.dailyMilk }}ml · {{ grp.items.length }}条</text>
					</view>
					<view class="day-body" v-if="isExpanded(grp.dateKey)">
					<view class="record-card" v-for="rec in grp.items" :key="rec.id" @click="goEdit(rec.id)">
						<view class="record-time-col">
							<text class="record-time">{{ formatTime(rec.timestamp) }}</text>
							<text class="record-interval" v-if="intervalOf(rec.id).length > 0">⏱ {{ intervalOf(rec.id) }}</text>
						</view>
						<view class="record-main">
							<view class="record-row1">
								<text class="record-milk" v-if="rec.milk > 0">🍼 {{ rec.milk }}ml</text>
								<text class="record-temp" v-if="rec.temperature > 0">🌡️ {{ rec.temperature.toFixed(1) }}°C</text>
								<text class="record-temp" v-if="rec.height > 0">📏 {{ rec.height.toFixed(2) }}cm</text>
								<text class="record-temp" v-if="rec.weight > 0">⚖️ {{ rec.weight.toFixed(2) }}kg</text>
								<text class="record-placeholder" v-if="rec.milk === 0 && rec.temperature === 0 && rec.height === 0 && rec.weight === 0">—</text>
							</view>
							<text class="record-day" v-if="currentBabyBirthday > 0">出生第 {{ daysAt(rec.timestamp) }} 天</text>
							<view class="record-tags" v-if="hasAnyTag(rec)">
								<view class="tag" v-for="sid in rec.supplementIds" :key="sid" :style="'background-color:' + getSuppColor(sid)">
									<text class="tag-text">{{ getSuppLabel(sid) }}</text>
								</view>
								<view class="tag tag-yellow" v-if="rec.pee">
									<text class="tag-text">💧 小便</text>
								</view>
								<view class="tag tag-brown" v-if="rec.poo">
									<text class="tag-text">💩 大便</text>
								</view>
							</view>
							<text class="record-note" v-if="rec.note.length > 0">📝 {{ rec.note }}</text>
						</view>
						<text class="record-arrow">›</text>
					</view>
					</view>
				</view>

				<view class="bottom-pad"></view>
			</view>
		</scroll-view>
		<custom-tabbar active="list" />
	</view>
</template>

<script setup lang="uts">
	import { loadRecords, loadSettings, findSupplement, getCurrentBaby, FeedingRecord, Settings, Supplement, Baby } from '@/utils/db.uts'
	import { getDateStr, getTimeStr, getStartOfDay, getRelativeDay, getDaysFromBirth, pad2 } from '@/utils/format.uts'

	type DayGroup = {
		dateKey : string
		title : string
		items : FeedingRecord[]
		dailyMilk : number
	}

	const records = ref<FeedingRecord[]>([] as FeedingRecord[])
	const settings = ref<Settings>(loadSettings())
	// 展开的日期分组 key 集合；默认全部折叠
	const expandedKeys = ref<string[]>([] as string[])

	function isExpanded(key : string) : boolean {
		return expandedKeys.value.indexOf(key) >= 0
	}

	function toggleDay(key : string) : void {
		const next : string[] = []
		let found = false
		expandedKeys.value.forEach((k : string) => {
			if (k === key) {
				found = true
			} else {
				next.push(k)
			}
		})
		if (!found) next.push(key)
		expandedKeys.value = next
	}

	// 每条记录距离上一条（时间更早的相邻记录）的间隔，格式 小时:分钟
	function formatInterval(ms : number) : string {
		let v = ms
		if (v < 0) v = 0
		const totalMin = Math.floor(v / 60000)
		const h = Math.floor(totalMin / 60)
		const m = totalMin - h * 60
		return h.toString() + ':' + pad2(m)
	}

	const intervalMap = computed<Map<string, string>>(() : Map<string, string> => {
		const m : Map<string, string> = new Map<string, string>()
		// 不依赖 records 的存储顺序：先按时间升序排副本，再取与上一条（更早一条）的间隔
		const sorted : FeedingRecord[] = []
		records.value.forEach((r : FeedingRecord) => { sorted.push(r) })
		sorted.sort((a : FeedingRecord, b : FeedingRecord) : number => a.timestamp - b.timestamp)
		for (let i = 1; i < sorted.length; i++) {
			const diff = sorted[i].timestamp - sorted[i - 1].timestamp
			m.set(sorted[i].id, formatInterval(diff))
		}
		return m
	})

	function intervalOf(id : string) : string {
		const v = intervalMap.value.get(id)
		return v != null ? v : ''
	}

	const currentBabyBirthday = computed<number>(() : number => {
		const b = getCurrentBaby(settings.value)
		return b != null ? b.birthday : 0
	})

	function daysAt(ts : number) : number {
		return getDaysFromBirth(currentBabyBirthday.value, ts)
	}

	function getSuppLabel(id : string) : string {
		const s = findSupplement(settings.value.supplements, id)
		if (s == null) return '—'
		return s.icon + ' ' + s.name
	}

	function getSuppColor(id : string) : string {
		const s = findSupplement(settings.value.supplements, id)
		if (s == null) return '#F4F4F5'
		return s.color
	}

	function hasAnyTag(rec : FeedingRecord) : boolean {
		return (rec.supplementIds != null && rec.supplementIds.length > 0) || rec.pee || rec.poo
	}

	const grouped = computed<DayGroup[]>(() : DayGroup[] => {
		const map : Map<string, DayGroup> = new Map<string, DayGroup>()
		records.value.forEach((r : FeedingRecord) => {
			const ds = getStartOfDay(r.timestamp)
			const key = getDateStr(ds)
			let grp = map.get(key)
			if (grp == null) {
				grp = {
					dateKey: key,
					title: getRelativeDay(ds),
					items: [] as FeedingRecord[],
					dailyMilk: 0
				} as DayGroup
				map.set(key, grp)
			}
			grp.items.push(r)
			grp.dailyMilk += r.milk
		})
		const result : DayGroup[] = []
		map.forEach((v : DayGroup) => {
			result.push(v)
		})
		result.sort((a : DayGroup, b : DayGroup) : number => {
			if (a.dateKey < b.dateKey) return 1
			if (a.dateKey > b.dateKey) return -1
			return 0
		})
		return result
	})

	function formatTime(ts : number) : string {
		return getTimeStr(ts)
	}

	function goEdit(id : string) : void {
		uni.navigateTo({ url: '/pages/record/record?id=' + id })
	}

	onShow(() => {
		records.value = loadRecords()
		settings.value = loadSettings()
	})
</script>

