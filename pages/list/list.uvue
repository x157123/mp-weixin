		flex-direction: column;
		margin-bottom: 12rpx;
	}

	.day-header {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 20rpx 32rpx 12rpx 32rpx;
	}

	.day-header-left {
		flex-direction: row;
		align-items: center;
	}

	.day-dot {
		width: 12rpx;
		height: 12rpx;
		border-radius: 6rpx;
		background-color: #FF6B7A;
		margin-right: 12rpx;
	}

	.day-chevron {
		font-size: 24rpx;
		color: #FF6B7A;
		width: 28rpx;
		margin-right: 8rpx;
	}

	.day-body {
		flex-direction: column;
	}

	.day-label {
		font-size: 28rpx;
		font-weight: bold;
		color: #3A3A3A;
	}

	.day-summary {
		font-size: 24rpx;
		color: #999;
	}

	.record-card {
		background-color: #FFFFFF;
		border-radius: 24rpx;
		padding: 24rpx 24rpx 24rpx 20rpx;
		margin: 0 24rpx 12rpx 24rpx;
