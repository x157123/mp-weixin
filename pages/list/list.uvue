	}

	.record-temp {
		font-size: 26rpx;
		color: #888;
	}

	.record-placeholder {
		font-size: 26rpx;
		color: #BBB;
	}

	.record-tags {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 10rpx;
	}

	.tag {
		padding: 6rpx 16rpx;
		border-radius: 20rpx;
		margin-right: 10rpx;
		margin-top: 4rpx;
	}

	.tag-pink {
		background-color: #FFE4E6;
	}

	.tag-yellow {
		background-color: #FFF3CD;
	}

	.tag-brown {
		background-color: #EAD9C9;
	}

	.tag-text {
